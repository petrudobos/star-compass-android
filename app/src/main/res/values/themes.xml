<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StarCompass" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/night_sky</item>
        <item name="colorOnPrimary">@color/star_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSecondaryVariant">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.SkyMapClone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/star_white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/night_sky</item>
        <item name="android:windowLightStatusBar" tools:targetApi="l">false</item>
    </style>

    <style name="Theme.StarCompass.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.StarCompass.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
