<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/arSkyFragment">

    <fragment
        android:id="@+id/arSkyFragment"
        android:name="com.example.skymap.ArSkyFragment"
        android:label="@string/nav_ar"
        tools:layout="@layout/fragment_ar_sky">
        <action
            android:id="@+id/action_ar_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.skymap.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/tonightFragment"
        android:name="com.example.skymap.TonightFragment"
        android:label="@string/nav_tonight"
        tools:layout="@layout/fragment_tonight" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.skymap.SettingsFragment"
        android:label="@string/nav_settings" />

</navigation>
